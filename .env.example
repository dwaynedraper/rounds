# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets, never paste them
# into chat/PR descriptions/issues either.

# ============================================================
# REQUIRED RIGHT NOW — nothing else works without this one.
# ============================================================

# Neon Postgres connection string (HTTP driver, region us-east-1 — plan
# §1 item 13). Get this from the Neon dashboard for the "rounds" project.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth secret. Required for the BUILD, not just for login — Better
# Auth initialises at module load, so `next build` crashes without it even
# though the survey is loginless. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ============================================================
# S2 RATE LIMITING (plan §7 S2, §1 #17b) — Upstash Redis.
# Free tier, no credit card. Create a database in us-east-1.
#
# Leave these blank locally and rate limiting is INACTIVE: the app
# logs a warning and allows every write. That is deliberate
# ("degrade safe, not open") — S1 validation and S5 audit still run.
# In production these MUST be set, or the loginless write endpoints
# have no abuse damper at all.
# ============================================================

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================
# NOT NEEDED YET — nothing reads these until you use the CMS.
# Left here now so the shape of the file doesn't change later;
# blank/placeholder values are fine until then.
# ============================================================

# Better Auth (CMS login only; survey stays loginless)
BETTER_AUTH_URL="http://localhost:3000"

# Resend (Phase 2 — magic-link email)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Rounds <onboarding@resend.dev>"

# Feature flags — default OFF (plan S9). Config, not code, to turn on.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
STORE_SLUG_MODE="off"
